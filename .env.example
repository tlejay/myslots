# ─── Google Calendar (leave blank to run in demo mode) ────────────────────────
# See README → "Connect your Google Calendar" for how to obtain each value.

# OAuth client from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long-lived refresh token — run `pnpm token` to mint one
GOOGLE_REFRESH_TOKEN=

# The calendar to read free/busy from and write events to.
# Usually the Google account's own address, e.g. you@example.com
GOOGLE_CALENDAR_ID=
